// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  clerkUserId    String?   @unique
  githubUsername String?  
  name           String?
  email          String?
  createdAt      DateTime @default(now())

  repos           RepoCache[]
  resumes         Resume[]
  userCache       UserCache?
  personalDetails Json?
}

model UserCache {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  details Json

  @@index([userId])
}

model RepoCache {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  repoName String
  score    Float

  pushedAt DateTime?

  metadata Json?

  lastComputed DateTime @default(now())

  @@index([userId])
}

model Resume {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  markdown  String
  resumeUrl String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// Cleaner Schema from here

model Company {
  id         Int     @id @default(autoincrement())
  name       String
  boardToken String? @unique
  jobs       Job[]
}

model Job {
  id          Int       @id @default(autoincrement())
  companyId   Int
  companyName String
  externalId  BigInt
  title       String
  content     String?
  absoluteUrl String?
  location    String?
  isActive    Boolean   @default(true)
  metadata    Json?
  department  Json?
  offices     Json?
  postedAt    DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, externalId])
}

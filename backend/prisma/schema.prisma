// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String      @id @default(uuid())
  githubUsername    String      @unique
  name              String?
  email             String?
  createdAt         DateTime @default(now())

  repos             RepoCache[]
  resumes           Resume[]
  userCache         UserCache?
}

model UserCache {
  id            String      @id @default(uuid())
  userId        String      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  details       Json

  @@index([userId])
}

model RepoCache {
  id            String      @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  repoName      String
  score         Float

  pushedAt      DateTime?

  metadata      Json?

  lastComputed  DateTime  @default(now())

  @@index([userId])
}

model Resume {
  id          String      @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  markdown    String
  resumeUrl   String?

  createdAt   DateTime @default(now())

  @@index([userId])
}

model GreenhouseJob {
  id              String   @id @default(uuid())
  sourceJobId     String
  companySlug     String
  companyName     String?
  title           String
  absoluteUrl     String
  location        String?
  department      String?
  offices         String?
  content         String?
  active          Boolean  @default(true)
  raw             Json?
  sourceUpdatedAt DateTime?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companySlug, sourceJobId])
  @@index([companySlug])
  @@index([active])
  @@index([title])
  @@index([lastSeenAt])
  @@index([companySlug, active])
}
